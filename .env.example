# ==========================================
# CẤU HÌNH DISCORD WEBHOOK
# ==========================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ==========================================
# CẤU HÌNH GOOGLE GEMINI AI
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# CẤU HÌNH MISTRAL AI
# ==========================================
MISTRAL_API_KEY=your_mistral_api_key_here

# ==========================================
# CẤU HÌNH AI MODELS
# ==========================================
MAIN_MODEL=gemini-3-flash-preview
# MAIN_MODEL=gemini-2.5-flash
# MAIN_MODEL=mistral-small-latest
FALLBACK_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/gemini-embedding-001
# MAIN_MODEL=mistral-medium-latest
RETRIEVAL_K=15
LLM_TEMPERATURE=0.2

# ==========================================
# CẤU HÌNH SYSTEM PROMPT
# ==========================================
SYSTEM_PROMPT=Bạn là một trợ lý AI phân tích quy chế cho sinh viên Đại học Bách Khoa (HCMUT). Hãy đọc TOÀN BỘ tài liệu (bao gồm cả văn bản, bảng biểu, biểu đồ, hình chụp scan và ĐẶC BIỆT chú ý các Phụ lục ở cuối nếu có). Hãy trích xuất những THAY ĐỔI, QUY ĐỊNH hoặc CẬP NHẬT QUAN TRỌNG NHẤT đối với sinh viên. Yêu cầu: Tiếng Việt, dùng gạch đầu dòng, chi tiết nhưng không rườm rà (tối đa khoảng 1500-2000 ký tự). Đi thẳng vào vấn đề.

# ==========================================
# CẤU HÌNH FILE TRẠNG THÁI
# ==========================================
STATE_FILE=seen_laws.json

# ==========================================
# CẤU HÌNH SELENIUM
# ==========================================
HEADLESS_MODE=true
WAIT_TIME=8
DELAY_BETWEEN_REQUESTS=5

# ==========================================
# CẤU HÌNH TIMEOUT
# ==========================================
PDF_DOWNLOAD_TIMEOUT=60
DISCORD_REQUEST_TIMEOUT=15

# ==========================================
# CẤU HÌNH CACHE
# ==========================================
# Base directory for all caches (crawled PDFs, processed records)
# Default: ../cache/ (relative to phase2-chatbot/)
CACHE_DIR=cache

# Path to crawled/processed regulations cache file (JSONL format)
# Default: <CACHE_DIR>/processed_records.jsonl
CRAWLED_CACHE_FILE=cache/processed_records.jsonl

# Processor state file for deduping crawled regulation URLs
PROCESSOR_STATE_FILE=phase2-chatbot/processor_seen_laws.json

# Enable local caching of processed documents
# Default: true
PROCESSOR_CACHE_ENABLED=true

# ==========================================
# CẤU HÌNH EMBEDDING
# ==========================================
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_TASK_TYPE=retrieval_document
EMBEDDING_RETRY_COUNT=3
EMBEDDING_RETRY_DELAY=1.5

# ==========================================
# CẤU HÌNH CHUNKING
# ==========================================
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ==========================================
# CẤU HÌNH VECTOR STORE
# ==========================================
UPSERT_BATCH_SIZE=32

# ==========================================
# CẤU HÌNH MILVUS (Vector Database on Docker)
# ==========================================
# Milvus server host for Docker Compose
# Default: localhost (when running docker-compose locally)
MILVUS_HOST=localhost

# Milvus server port
# Default: 19530
MILVUS_PORT=19530

# Milvus collection name for regulation chunks
# Default: hcmut_regulations
MILVUS_COLLECTION_NAME=hcmut_regulations